APP_NAME="E-commerce Commerce API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
API_DOCS_ENABLED=true
CSV_MAX_BYTES=5242880
CSV_MAX_ROWS=10000
CSV_UPLOAD_RATE_LIMIT=5
RESERVATION_TIMEOUT_SECONDS=120
GUEST_ORDER_LINK_DAYS=30
GUEST_ORDER_RATE_LIMIT=60
CHECKOUT_RATE_LIMIT=30
IMAGE_UPLOAD_RATE_LIMIT=10
ORDER_NUMBER_PREFIX=ORD-
ORDER_NUMBER_START=100001
PAYMENT_API_URL=http://127.0.0.1:8001/api/v1/payments
PAYMENT_CALLBACK_URL=http://127.0.0.1:8000/api/v1/payments/webhooks/mock
PAYMENT_CONNECT_TIMEOUT_SECONDS=2
PAYMENT_TIMEOUT_SECONDS=5
PAYMENT_WEBHOOK_TOKEN=local-only-webhook-token-change-me
PAYMENT_WEBHOOK_RATE_LIMIT=120
RESERVATION_EXPIRATION_BATCH_SIZE=100
RESERVATION_CLAIM_TTL_SECONDS=60
RESERVATION_WORKER_INTERVAL_SECONDS=5

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecommerce
DB_USERNAME=ecommerce
DB_PASSWORD=local-only-database-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
SECURITY_REQUIRE_TLS=false

AUTH_LOGIN_RATE_LIMIT=5
AUTH_SETUP_RATE_LIMIT=3
AUTH_CUSTOMER_REGISTRATION_RATE_LIMIT=5
AUTH_GUEST_REGISTRATION_RATE_LIMIT=5

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
