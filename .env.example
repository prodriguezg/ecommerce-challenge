# Local development defaults only. Replace every credential outside local use.
COMPOSE_PROJECT_NAME=ecommerce-challenge
FRONTEND_PORT=8080
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379

MYSQL_DATABASE=ecommerce
MYSQL_USER=ecommerce
MYSQL_PASSWORD=local-only-database-password
MYSQL_ROOT_PASSWORD=local-only-root-password

COMMERCE_APP_KEY=base64:MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=
PAYMENT_APP_KEY=base64:MTExMTExMTExMTExMTExMTExMTExMTExMTExMTExMTE=
PAYMENT_WEBHOOK_TOKEN=local-only-webhook-token-change-me

# Browser/session defaults below are for local HTTP only. Production-like
# environments must use HTTPS, set both flags to true, and disable API docs.
SECURITY_REQUIRE_TLS=false
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

RESERVATION_TIMEOUT_SECONDS=120
RESERVATION_WORKER_INTERVAL_SECONDS=5
RESERVATION_EXPIRATION_BATCH_SIZE=100
RESERVATION_CLAIM_TTL_SECONDS=60
PAYMENT_WEBHOOK_RATE_LIMIT=120
GUEST_ORDER_LINK_DAYS=30
GUEST_ORDER_RATE_LIMIT=60
AUTH_LOGIN_RATE_LIMIT=5
AUTH_SETUP_RATE_LIMIT=3
AUTH_CUSTOMER_REGISTRATION_RATE_LIMIT=5
AUTH_GUEST_REGISTRATION_RATE_LIMIT=5
CHECKOUT_RATE_LIMIT=30
IMAGE_UPLOAD_RATE_LIMIT=10
CSV_UPLOAD_RATE_LIMIT=5
PAYMENT_REQUEST_RATE_LIMIT=60
PAYMENT_NORMAL_DELAY_MIN_SECONDS=2
PAYMENT_NORMAL_DELAY_MAX_SECONDS=8
PAYMENT_LATE_SUCCESS_DELAY_SECONDS=150
CSV_MAX_BYTES=5242880
CSV_MAX_ROWS=10000
ORDER_NUMBER_PREFIX=ORD-
ORDER_NUMBER_START=100001
API_DOCS_ENABLED=true
